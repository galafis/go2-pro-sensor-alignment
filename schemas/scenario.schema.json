{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/galafis/go2-pro-sensor-alignment/blob/main/schemas/scenario.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "source",
    "maxResidualM",
    "pairs",
    "evaluationPoints"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "source": {
      "enum": ["synthetic", "manual"]
    },
    "maxResidualM": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 100
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "observed", "reference", "weight"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "observed": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "minItems": 2,
            "maxItems": 2
          },
          "reference": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "minItems": 2,
            "maxItems": 2
          },
          "weight": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 1000
          }
        }
      },
      "minItems": 2,
      "maxItems": 200
    },
    "evaluationPoints": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 0,
      "maxItems": 1000
    }
  }
}
